                    </option>

                    <option value="1">
                        Correct Answer: B
                    </option>

                    <option value="2">
                        Correct Answer: C
                    </option>

                    <option value="3">
                        Correct Answer: D
                    </option>

                </select>

                <button onclick="addQuestion()">
                    ➕ Add Question
                </button>

            </div>


            <h3>Question List</h3>

            <div id="questionList"></div>

        </div>

    </div>

    <script src="script.js"></script>

</body>
</html>
