// ================= VARIABLES =================

let currentQuestion = 0;

let score = 0;

let selectedAnswer = null;

let submitted = false;

let answered = [];


// ================= LOAD QUESTION =================

function loadQuestion() {

    let q = questions[currentQuestion];

    document.getElementById("question").textContent =
        q.question;

    document.getElementById("questionNumber").textContent =
        "Question " +
        (currentQuestion + 1) +
        " of " +
        questions.length;

    document.getElementById("score").textContent =
        "Score: " + score;


    let optionsDiv =
        document.getElementById("options");

    optionsDiv.innerHTML = "";


    selectedAnswer = null;

    submitted = false;


    document.getElementById("result").textContent = "";


    q.options.forEach(function(option, index) {

        let button =
            document.createElement("button");

        button.className = "option";

        button.textContent =
            String.fromCharCode(65 + index) +
            ") " +
            option;

        button.onclick = function() {

            selectOption(index);

        };

        optionsDiv.appendChild(button);

    });


    // If already answered
    if (answered[currentQuestion] !== undefined) {

        selectedAnswer =
            answered[currentQuestion];

        submitted = true;

        let buttons =
            document.querySelectorAll(".option");


        buttons.forEach(function(button, index) {

            if (index === selectedAnswer) {

                button.classList.add("selected");

            }

            if (index === q.answer) {

                button.classList.add("correct");

            }

            if (
                index === selectedAnswer &&
                selectedAnswer !== q.answer
            ) {

                button.classList.add("wrong");

            }

        });


        if (selectedAnswer === q.answer) {

            document.getElementById("result").textContent =
                "✅ Correct Answer!";

        } else {

            document.getElementById("result").textContent =
                "❌ Wrong Answer!";

        }

    }

}


// ================= SELECT OPTION =================

function selectOption(index) {

    if (submitted) {

        return;

    }

    selectedAnswer = index;


    let buttons =
        document.querySelectorAll(".option");


    buttons.forEach(function(button) {

        button.classList.remove("selected");

    });


    buttons[index].classList.add("selected");

}


// ================= SUBMIT =================

function submitAnswer() {

    if (selectedAnswer === null) {

        alert("Please select an option!");

        return;

    }


    if (submitted) {

        return;

    }


    let correctAnswer =
        questions[currentQuestion].answer;


    answered[currentQuestion] =
        selectedAnswer;


    submitted = true;


    let buttons =
        document.querySelectorAll(".option");


    buttons.forEach(function(button, index) {

        if (index === correctAnswer) {

            button.classList.add("correct");

        }


        if (
            index === selectedAnswer &&
            selectedAnswer !== correctAnswer
        ) {

            button.classList.add("wrong");

        }

    });


    if (selectedAnswer === correctAnswer) {

        score++;

        document.getElementById("result").textContent =
            "✅ Correct Answer!";

    } else {

        document.getElementById("result").textContent =
            "❌ Wrong Answer!";

    }


    document.getElementById("score").textContent =
        "Score: " + score;

}


// ================= NEXT =================

function nextQuestion() {

    if (currentQuestion < questions.length - 1) {

        currentQuestion++;

        loadQuestion();

    } else {

        alert(
            "Quiz Completed! Your Score is " +
            score +
            " / " +
            questions.length
        );

    }

}


// ================= PREVIOUS =================

function previousQuestion() {

    if (currentQuestion > 0) {

        currentQuestion--;

        loadQuestion();

    }

}


// ================= RESTART =================

function restartQuiz() {

    currentQuestion = 0;

    score = 0;

    selectedAnswer = null;

    submitted = false;

    answered = [];


    loadQuestion();

}


// ================= SHOW QUIZ =================

function showQuiz() {

    document.getElementById("quizSection").style.display =
        "block";

    document.getElementById("manageSection").style.display =
        "none";

}


// ================= SHOW MANAGE =================

function showManage() {

    document.getElementById("quizSection").style.display =
        "none";

    document.getElementById("manageSection").style.display =
        "block";

    displayQuestions();

}


// ================= ADD QUESTION =================

function addQuestion() {

    let question =
        document.getElementById("newQuestion").value;

    let a =
        document.getElementById("optionA").value;

    let b =
        document.getElementById("optionB").value;

    let c =
        document.getElementById("optionC").value;

    let d =
        document.getElementById("optionD").value;

    let answer =
        Number(
            document.getElementById("correctAnswer").value
        );


    if (
        question === "" ||
        a === "" ||
        b === "" ||
        c === "" ||
        d === ""
    ) {

        alert("Please fill all fields!");

        return;

    }


    questions.push({

        question: question,

        options: [a, b, c, d],

        answer: answer

    });


    alert("Question added successfully!");


    document.getElementById("newQuestion").value = "";

    document.getElementById("optionA").value = "";

    document.getElementById("optionB").value = "";

    document.getElementById("optionC").value = "";

    document.getElementById("optionD").value = "";


    displayQuestions();

}


// ================= DISPLAY QUESTIONS =================

function displayQuestions() {

    let list =
        document.getElementById("questionList");

    list.innerHTML = "";


    questions.forEach(function(q, index) {

        let div =
            document.createElement("div");

        div.className = "question-item";


        div.innerHTML = `

            <p>
                ${index + 1}. ${q.question}
            </p>

            <small>
                Correct Answer:
                ${String.fromCharCode(65 + q.answer)}
            </small>

            <br><br>

            <button
                class="edit-btn"
                onclick="editQuestion(${index})">
                ✏️ Edit
            </button>

            <button
                class="delete-btn"
                onclick="deleteQuestion(${index})">
                🗑️ Delete
            </button>

        `;


        list.appendChild(div);

    });

}


// ================= DELETE =================

function deleteQuestion(index) {

    if (
        confirm(
            "Are you sure you want to delete this question?"
        )
    ) {

        questions.splice(index, 1);


        if (currentQuestion >= questions.length) {

            currentQuestion =
                questions.length - 1;

        }


        displayQuestions();

        loadQuestion();

    }

}


// ================= EDIT =================

function editQuestion(index) {

    let q = questions[index];


    let newQuestion =
        prompt(
            "Enter new question:",
            q.question
        );


    if (newQuestion === null) {

        return;

    }


    let newA =
        prompt(
            "Enter Option A:",
            q.options[0]
        );


    let newB =
        prompt(
            "Enter Option B:",
            q.options[1]
        );


    let newC =
        prompt(
            "Enter Option C:",
            q.options[2]
        );


    let newD =
        prompt(
            "Enter Option D:",
            q.options[3]
        );


    let newAnswer =
        prompt(
            "Enter correct answer (A/B/C/D):",
            String.fromCharCode(65 + q.answer)
        );


    let answerIndex =
        newAnswer.toUpperCase().charCodeAt(0) - 65;


    questions[index] = {

        question: newQuestion,

        options: [
            newA,
            newB,
            newC,
            newD
        ],

        answer: answerIndex

    };


    displayQuestions();

    loadQuestion();

    alert("Question updated!");

}


