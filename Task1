* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f1f3f6;
}

.container {
    width: 90%;
    max-width: 750px;
    margin: 30px auto;
}

h1 {
    text-align: center;
    color: #222;
}

.menu {
    text-align: center;
    margin-bottom: 20px;
}

.menu button {
    background: #4a69bd;
    color: white;
    border: none;
    padding: 12px 25px;
    margin: 5px;
    border-radius: 8px;
    cursor: pointer;
}

.menu button:hover {
    background: #344e9b;
}


/* QUIZ */

.top {
    display: flex;
    justify-content: space-between;

    background: white;
    padding: 15px;

    border-radius: 10px;

    margin-bottom: 15px;

    font-weight: bold;
}

.quiz-card {
    background: white;

    padding: 30px;

    border-radius: 15px;

    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.quiz-card h2 {
    margin-bottom: 25px;
}


/* OPTIONS */

.option {
    width: 100%;

    padding: 15px;

    margin: 10px 0;

    text-align: left;

    background: #f5f5f5;

    border: 2px solid #ddd;

    border-radius: 8px;

    cursor: pointer;

    font-size: 16px;
}

.option:hover {
    background: #e8edff;
}

.option.selected {
    background: #dce5ff;

    border-color: #4a69bd;
}

.option.correct {
    background: #d4edda;

    border-color: #28a745;
}

.option.wrong {
    background: #f8d7da;

    border-color: #dc3545;
}


/* RESULT */

#result {
    text-align: center;

    font-size: 18px;

    font-weight: bold;

    min-height: 25px;
}


/* BUTTONS */

button {
    font-size: 15px;

    border: none;

    border-radius: 8px;

    padding: 12px 20px;

    cursor: pointer;
}

.submit {
    display: block;

    margin: auto;

    background: #4a69bd;

    color: white;
}

.submit:hover {
    background: #344e9b;
}

.navigation {
    display: flex;

    justify-content: space-between;

    margin-top: 20px;
}

.navigation button {
    background: #333;

    color: white;
}

.navigation button:hover {
    background: #555;
}

.restart {
    display: block;

    margin: 20px auto;

    background: #e67e22;

    color: white;
}


/* MANAGE */

#manageSection {
    display: none;

    background: white;

    padding: 25px;

    border-radius: 15px;
}

.form {
    display: flex;

    flex-direction: column;

    gap: 10px;
}

.form input,
.form select {
    padding: 12px;

    border: 1px solid #ccc;

    border-radius: 7px;

    font-size: 15px;
}

.form button {
    background: #27ae60;

    color: white;
}

.form button:hover {
    background: #219150;
}


/* QUESTION LIST */

.question-item {
    background: #f5f5f5;

    padding: 15px;

    margin: 10px 0;

    border-radius: 8px;
}

.question-item p {
    font-weight: bold;
}

.edit-btn {
    background: #3498db;

    color: white;

    margin-right: 5px;
}

.delete-btn {
    background: #e74c3c;

    color: white;
}


/* MOBILE */

@media (max-width: 600px) {

    .container {
        width: 95%;
    }

    .quiz-card {
        padding: 20px;
    }

    .navigation {
        flex-direction: column;
    }

    .navigation button {
        margin: 5px 0;
    }
}
