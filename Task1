        <div id="manageSection">

            <h2>Manage Questions</h2>

            <div class="form">

                <input
                    type="text"
                    id="newQuestion"
                    placeholder="Enter question"
                >

                <input
                    type="text"
                    id="optionA"
                    placeholder="Option A"
                >

                <input
                    type="text"
                    id="optionB"
                    placeholder="Option B"
                >

                <input
                    type="text"
                    id="optionC"
                    placeholder="Option C"
                >

                <input
                    type="text"
                    id="optionD"
                    placeholder="Option D"
                >

                <select id="correctAnswer">

                    <option value="0">
